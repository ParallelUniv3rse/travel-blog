---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';
---

<header>
	<nav>
		<a class="site-title" href={withBase('/')}>{SITE_TITLE}</a>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		max-width: 720px;
		margin: 0 auto;
	}
	.site-title {
		display: inline-block;
		padding: 0.75em 0;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
	}
</style>
