---
import { tagUrl } from '../utils';
interface Props {
	tags: string[];
}
const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>
					<a href={tagUrl(tag)}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}
<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		list-style: none;
		padding: 0;
		margin: 0.5em 0;
		font-size: 0.9em;
	}
</style>
