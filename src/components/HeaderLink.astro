---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const strip = (p: string) => p.replace(/\/$/, '');
const current = strip(Astro.url.pathname);
const target = strip(String(href));
const base = strip(import.meta.env.BASE_URL);
const isActive =
	target === base ? current === base || current.startsWith(`${base}/blog`) : current.startsWith(target);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
