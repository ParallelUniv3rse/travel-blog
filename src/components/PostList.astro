---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { postUrl } from '../utils';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

{posts.length === 0 && <p>Zatím žádné příspěvky.</p>}
<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={postUrl(post)}>
					{post.data.cover && (
						<Image src={post.data.cover} alt={post.data.coverAlt ?? ''} width={720} height={360} />
					)}
					<h2 class="title">{post.data.title}</h2>
				</a>
				<p class="meta">
					<FormattedDate date={post.data.date} />
					{post.data.draft && <strong> · koncept</strong>}
				</p>
				<p class="description">{post.data.description}</p>
			</li>
		))
	}
</ul>
<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		margin-bottom: 2.5em;
	}
	.posts a {
		text-decoration: none;
		color: inherit;
	}
	.posts img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		margin-bottom: 0.5em;
	}
	.title {
		font-size: 1.5em;
		margin: 0;
	}
	.posts a:hover .title {
		color: var(--accent);
	}
	.meta,
	.description {
		margin: 0.25em 0 0 0;
	}
	.meta {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
</style>
